<div class="tracker-settings-wrapper">

    <!-- NAVIGATION TABS -->
    <nav class="tracker-nav tabs">
        <a class="item active" data-tab="identity"><i class="fas fa-fingerprint"></i> Identity</a>
        <a class="item" data-tab="mechanics"><i class="fas fa-calculator"></i> Mechanics</a>
        <a class="item" data-tab="audio"><i class="fas fa-volume-up"></i> Audio</a>
        <a class="item" data-tab="chat"><i class="fas fa-comments"></i> Chat</a>
        <a class="item" data-tab="rules"><i class="fas fa-cogs"></i> Rules</a>
    </nav>

    <!-- TAB CONTENT CONTAINER -->
    <section class="tab-content">
        
        <!-- =======================
             TAB: IDENTITY 
             ======================= -->
        <div class="tab active" data-tab="identity">
            
            <div class="config-card">
                <h3><i class="fas fa-eye"></i> Visual Identity</h3>
                
                <div class="form-group">
                    <label>Attribute Name</label>
                    <input type="text" name="attributeName" value="{{attributeName}}" maxlength="14" placeholder="e.g. Despair, Stress, Corruption">
                    <span class="hint">The name displayed on the character sheet (Max 14 chars).</span>
                </div>

                <div class="form-group">
                     <label>Icon Style</label>
                    <select name="attributeIcon">
                        {{#each iconChoices}}
                        <option value="{{this.value}}" {{#if (eq this.value ../attributeIcon)}}selected{{/if}}>{{this.label}}</option>
                        {{/each}}
                    </select>
                    <span class="hint">Icon used for filled pips.</span>
                </div>

                <div class="form-group">
                    <label>Text Color</label>
                    <div class="color-picker-wrapper">
                        <input type="color" class="color-input" name="attributeColor" value="{{attributeColor}}">
                    </div>
                    <span class="hint">Color for the tracker label and filler lines.</span>
                </div>

                <div class="form-group">
                    <label>Icon Color</label>
                    <div class="color-picker-wrapper">
                        <input type="color" class="color-input" name="iconColor" value="{{iconColor}}">
                    </div>
                    <span class="hint">Color for the pip icons.</span>
                </div>

                <!-- Custom Background Section -->
                <div class="form-group custom-toggle-group">
                    <label class="toggle-switch">
                        <input type="checkbox" name="enableCustomBackground" {{checked enableCustomBackground}}>
                        <span class="slider"></span>
                        <span class="toggle-label">Custom Background Color</span>
                    </label>
                    <span class="hint">
                        <strong>OFF:</strong> Uses default dark blue (#18162e).<br>
                        <strong>ON:</strong> Choose a specific color below.
                    </span>
                </div>

                <!-- Hidden Color Picker (Toggled by JS) -->
                <div class="form-group custom-bg-picker-container">
                    <label>Background Color</label>
                    <div class="color-picker-wrapper">
                        <input type="color" class="color-input" name="customBackgroundColor" value="{{customBackgroundColor}}">
                    </div>
                </div>

                <!-- Custom Border Section -->
                <div class="form-group custom-toggle-group">
                    <label class="toggle-switch">
                        <input type="checkbox" name="enableCustomBorder" {{checked enableCustomBorder}}>
                        <span class="slider"></span>
                        <span class="toggle-label">Custom Border Color</span>
                    </label>
                    <span class="hint">
                        <strong>OFF:</strong> Uses default gold (#f3c267).<br>
                        <strong>ON:</strong> Choose a specific color below.
                    </span>
                </div>

                <!-- Hidden Color Picker (Toggled by JS) -->
                <div class="form-group custom-border-picker-container">
                    <label>Border Color</label>
                    <div class="color-picker-wrapper">
                        <input type="color" class="color-input" name="customBorderColor" value="{{customBorderColor}}">
                    </div>
                </div>

            </div>
        </div>

        <!-- =======================
             TAB: MECHANICS 
             ======================= -->
        <div class="tab" data-tab="mechanics">
            
            <div class="config-card">
                <h3><i class="fas fa-cogs"></i> Core Rules</h3>
                
                <div class="form-group">
                    <label>Maximum Value</label>
                    <input type="number" name="attributeMax" value="{{attributeMax}}" min="1" max="{{maxPossible}}" step="1">
                    <span class="hint">How many pips does a new character start with? (Default capacity).</span>
                </div>

                <!-- Toggle Switch -->
                <div class="form-group custom-toggle-group">
                    <label class="toggle-switch">
                        <input type="checkbox" name="attributeInverted" {{checked attributeInverted}}>
                        <span class="slider"></span>
                        <span class="toggle-label">Invert Logic</span>
                    </label>
                    <span class="hint">
                        <strong>OFF:</strong> Fills up (0 to Max). Alert at Max.<br>
                        <strong>ON:</strong> Drains down (Max to 0). Alert at 0.
                    </span>
                </div>

                <div class="form-group custom-toggle-group">
                    <label class="toggle-switch">
                        <input type="checkbox" name="hideFromPlayers" {{checked hideFromPlayers}}>
                        <span class="slider"></span>
                        <span class="toggle-label">Hide Tracker from Players</span>
                    </label>
                    <span class="hint">
                        <strong>OFF:</strong> All players can see their tracker.<br>
                        <strong>ON:</strong> Tracker is hidden from non-GM users by default.<br>
                        Individual overrides can be set per actor in the Tracker Manager.
                    </span>
                </div>
            </div>
        </div>

        <!-- =======================
             TAB: AUDIO
             ======================= -->
        <div class="tab" data-tab="audio">
            <div class="config-card">
                <h3><i class="fas fa-bell"></i> Alert Sound</h3>

                <div class="form-group">
                    <label>Alert Sound</label>
                    <div class="file-input-group">
                        <input type="text" name="attributeSound" value="{{attributeSound}}" placeholder="path/to/sound.mp3">
                        <button type="button" class="file-picker" data-target="attributeSound" data-type="audio" title="Browse Audio"><i class="fas fa-music"></i></button>
                    </div>
                    <span class="hint">Audio file played when the tracker reaches its limit. <strong>Clear this field to disable sound.</strong></span>
                </div>

                <div class="form-group">
                    <label>Volume Level (<span class="volume-display">{{attributeVolume}}</span>)</label>
                    <input type="range" name="attributeVolume" value="{{attributeVolume}}" min="0.1" max="1.0" step="0.1">
                    <span class="hint">Base volume for the alert. <strong>Note:</strong> Final volume is also controlled by each user's "Interface" volume settings.</span>
                </div>
            </div>

            <div class="config-card">
                <h3><i class="fas fa-hand-pointer"></i> Pip Click Sound</h3>

                <div class="form-group">
                    <label>Click Sound</label>
                    <div class="file-input-group">
                        <input type="text" name="pipClickSound" value="{{pipClickSound}}" placeholder="path/to/sound.mp3">
                        <button type="button" class="file-picker" data-target="pipClickSound" data-type="audio" title="Browse Audio"><i class="fas fa-music"></i></button>
                    </div>
                    <span class="hint">Plays locally for the clicking player on each pip change. Not played at alert state (max or zero). <strong>Clear to disable.</strong></span>
                </div>

                <div class="form-group">
                    <label>Click Volume (<span class="pip-volume-display">{{pipClickVolume}}</span>)</label>
                    <input type="range" name="pipClickVolume" value="{{pipClickVolume}}" min="0.1" max="1.0" step="0.1">
                    <span class="hint">Base volume for the click sound. Final volume also depends on your "Interface" volume setting.</span>
                </div>
            </div>
        </div>

        <!-- =======================
             TAB: CHAT 
             ======================= -->
        <div class="tab" data-tab="chat">
            
            <div class="config-card">
                <h3><i class="fas fa-comment-dots"></i> Chat Feedback</h3>
                
                <!-- Toggle Switch -->
                <div class="form-group custom-toggle-group">
                    <label class="toggle-switch">
                        <input type="checkbox" name="verbose" {{checked verbose}}>
                        <span class="slider"></span>
                        <span class="toggle-label">Verbose Mode</span>
                    </label>
                    <span class="hint">If enabled, a chat card is sent for <strong>every</strong> value change, not just critical alerts.</span>
                </div>

                <div class="form-group">
                    <label>Chat Card Background</label>
                    <div class="file-input-group">
                        <input type="text" name="chatImage" value="{{chatImage}}" placeholder="path/to/image.webp">
                        <button type="button" class="file-picker" data-target="chatImage" data-type="image" title="Browse Images"><i class="fas fa-image"></i></button>
                    </div>
                    <span class="hint">Optional background image for the notification card.</span>
                </div>
            </div>

            <div class="config-card">
                <h3><i class="fas fa-font"></i> Alert Messages</h3>
                
                <div class="form-group">
                    <label>"Max" Text</label>
                    <input type="text" name="textMax" value="{{textMax}}">
                    <span class="hint">Displayed when filling up.</span>
                </div>
                
                <div class="form-group">
                    <label>"Depleted" Text</label>
                    <input type="text" name="textDepleted" value="{{textDepleted}}">
                    <span class="hint">Displayed when draining.</span>
                </div>
            </div>
        </div>

        <!-- =======================
             TAB: RULES
             ======================= -->
        <div class="tab" data-tab="rules">
            <div class="config-card">
                <h3><i class="fas fa-scroll"></i> Pip Event Rules</h3>
                <span class="hint" style="margin-bottom: 10px; display: block;">
                    Define rules that apply Active Effects to the actor when pip events occur.
                </span>

                <div class="rules-list">
                    {{#each trackerRules}}
                    <div class="rule-row" data-rule-id="{{this.id}}">
                        <select class="rule-trigger" name="ruleTrigger">
                            <option value="mark" {{#if (eq this.trigger "mark")}}selected{{/if}}>On Mark</option>
                            <option value="unmark" {{#if (eq this.trigger "unmark")}}selected{{/if}}>On Unmark</option>
                            <option value="maximum" {{#if (eq this.trigger "maximum")}}selected{{/if}}>On Maximum</option>
                            <option value="minimum" {{#if (eq this.trigger "minimum")}}selected{{/if}}>On Minimum</option>
                        </select>
                        <select class="rule-target" name="ruleTarget">
                            <option value="hope" {{#if (eq this.target "hope")}}selected{{/if}}>Hope Max</option>
                            <option value="hpMax" {{#if (eq this.target "hpMax")}}selected{{/if}}>HP Max</option>
                            <option value="stressMax" {{#if (eq this.target "stressMax")}}selected{{/if}}>Stress Max</option>
                            <option value="scars"        {{#if (eq this.target "scars")}}selected{{/if}}>Scars</option>
                        <option value="evasion"      {{#if (eq this.target "evasion")}}selected{{/if}}>Evasion</option>
                        <option value="spellcasting" {{#if (eq this.target "spellcasting")}}selected{{/if}}>Spellcasting</option>
                        </select>
                        <select class="rule-action" name="ruleAction">
                            <option value="add" {{#if (eq this.action "add")}}selected{{/if}}>Add</option>
                            <option value="remove" {{#if (eq this.action "remove")}}selected{{/if}}>Remove</option>
                        </select>
                        <button type="button" class="rule-delete" title="Delete Rule"><i class="fas fa-trash"></i></button>
                    </div>
                    {{/each}}
                </div>

                <button type="button" class="rule-add-btn">
                    <i class="fas fa-plus"></i> Add Rule
                </button>
            </div>
        </div>

    </section>

    <footer class="sheet-footer flexrow">
        <button type="submit" name="submit">
            <i class="far fa-save"></i> Save Configuration
        </button>
    </footer>
</div>